{
	"name": "@sveltery/utils",
	"version": "0.0.0",
	"private": true,
	"description": "Framework-level helpers shared by Sveltery packages: DOM ownership, platform detection, timers and change-event details.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sveltery/base.git",
		"directory": "packages/utils"
	},
	"type": "module",
	"scripts": {
		"prepack": "svelte-package -i src -o dist && publint --strict"
	},
	"files": [
		"dist",
		"!dist/**/*.spec.*"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"svelte": "./dist/index.js",
				"default": "./dist/index.js"
			}
		}
	},
	"peerDependencies": {
		"svelte": "^5.57.1"
	},
	"dependencies": {
		"esm-env": "1.2.2"
	}
}
