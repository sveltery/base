{
  "name": "@sveltery/base",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./merge-props": {
      "types": "./dist/merge-props/index.d.ts",
      "default": "./dist/merge-props/index.js"
    },
    "./dialog": {
      "types": "./dist/dialog/index.d.ts",
      "svelte": "./dist/dialog/index.js",
      "default": "./dist/dialog/index.js"
    }
  },
  "svelte": "./dist/index.js",
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "build": "svelte-package -i src/lib -o dist"
  },
  "peerDependencies": {
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@sveltejs/package": "2.5.8",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
