  "scripts": {
    "dev": "vite dev",
    "build": "vite build && pnpm run prepack",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "prepack": "svelte-kit sync && svelte-package && publint --strict",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "pnpm run test:unit --run",
    "test:unit": "vitest --project server",
    "test:component": "vitest run --project client",
    "test:dom": "vitest run --project dom",
    "package:watch": "svelte-package --watch"
