{
  "name": "sveltery-base-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "pnpm -r check",
    "test": "pnpm --filter @sveltery/base test",
    "build": "pnpm --filter @sveltery/base build && pnpm --filter @sveltery/fixtures build",
    "package:check": "pnpm --filter @sveltery/base build && bash scripts/check-package.sh",
    "verify": "bash scripts/verify.sh",
    "test:browser": "playwright test"
  },
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@arethetypeswrong/core": "0.18.5",
    "@playwright/test": "1.63.0",
    "publint": "0.3.25"
  }
}
