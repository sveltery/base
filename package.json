{
	"name": "@sveltery/base",
	"version": "0.0.0",
	"private": true,
	"description": "Experimental, unofficial Svelte 5 port of Base UI components.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sveltery/base.git"
	},
	"type": "module",
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && pnpm --filter './packages/*' run prepack && svelte-package && node scripts/bundle-packages.mjs && node scripts/check-exported-props.mjs && publint --strict",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/check-form-types.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && node scripts/sync-exports.mjs --check",
		"format": "prettier --write .",
		"test:unit": "vitest run --project server",
		"test:component": "vitest run --project client",
		"test:e2e": "playwright test",
		"test": "vitest run && playwright test",
		"verify": "bash scripts/verify.sh",
		"verify:component": "bash scripts/verify-component.sh"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/**/*.test-d.*",
		"THIRD_PARTY_NOTICES.md"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
