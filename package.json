{
	"name": "@sveltery/base",
	"version": "0.0.0",
	"private": true,
	"description": "Experimental, unofficial Svelte 5 port of Base UI components.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sveltery/base.git"
	},
	"type": "module",
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint --strict",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run --project server",
		"test:component": "vitest run --project client",
		"test:e2e": "playwright test",
		"test": "vitest run && playwright test",
		"verify": "bash scripts/verify.sh",
		"verify:component": "bash scripts/verify-component.sh"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"THIRD_PARTY_NOTICES.md"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./accordion": {
			"types": "./dist/accordion/index.d.ts",
			"svelte": "./dist/accordion/index.js"
		},
		"./button": {
			"types": "./dist/button/index.d.ts",
			"svelte": "./dist/button/index.js"
		},
		"./checkbox": {
			"types": "./dist/checkbox/index.d.ts",
			"svelte": "./dist/checkbox/index.js"
		},
		"./collapsible": {
			"types": "./dist/collapsible/index.d.ts",
			"svelte": "./dist/collapsible/index.js"
		},
		"./fieldset": {
			"types": "./dist/fieldset/index.d.ts",
			"svelte": "./dist/fieldset/index.js"
		},
		"./separator": {
			"types": "./dist/separator/index.d.ts",
			"svelte": "./dist/separator/index.js"
		},
		"./toggle": {
			"types": "./dist/toggle/index.d.ts",
			"svelte": "./dist/toggle/index.js"
		},
		"./toggle-group": {
			"types": "./dist/toggle-group/index.d.ts",
			"svelte": "./dist/toggle-group/index.js"
		},
		"./avatar": {
			"types": "./dist/avatar/index.d.ts",
			"svelte": "./dist/avatar/index.js"
		},
		"./meter": {
			"types": "./dist/meter/index.d.ts",
			"svelte": "./dist/meter/index.js"
		},
		"./progress": {
			"types": "./dist/progress/index.d.ts",
			"svelte": "./dist/progress/index.js"
		},
		"./radio": {
			"types": "./dist/radio/index.d.ts",
			"svelte": "./dist/radio/index.js"
		},
		"./form": {
			"types": "./dist/form/index.d.ts",
			"svelte": "./dist/form/index.js"
		},
		"./switch": {
			"types": "./dist/switch/index.d.ts",
			"svelte": "./dist/switch/index.js"
		},
		"./tabs": {
			"types": "./dist/tabs/index.d.ts",
			"svelte": "./dist/tabs/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.57.1"
	},
	"devDependencies": {
		"@base-ui/react": "1.8.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.21",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"keywords": [
		"svelte",
		"components",
		"base-ui"
	],
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
