{
  "name": "sveltery-base-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "check": "pnpm -r check",
    "test": "pnpm --filter @sveltery/base test",
