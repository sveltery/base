          "line": 86,
          "text": "expect(meter).toHaveAttribute('aria-valuenow', '50')"
        },
        {
          "line": 87,
          "text": "expect(meter).toHaveAttribute('aria-valuetext', fiftyPercent)"
        },
        {
          "line": 88,
          "text": "expect(value.textContent).toBe(fiftyPercent)"
        },
        {
          "line": 89,
          "text": "expect(indicator.style.width).toBe('50%')"
