// Deploy this temporary config/spec together under .checks/native-composite-diagnostic/source/.
// Existing secured config remains the authority for browser, sandbox and server command.
import { defineConfig } from '@playwright/test';
import { resolve } from 'node:path';
import config from '../../../playwright.config.js';

const server = config.webServer;
if (!server || Array.isArray(server))
  throw new Error('The reviewed existing single secured fixture server is required');
if (config.use?.launchOptions?.chromiumSandbox !== true)
  throw new Error('The existing secured Chromium sandbox must remain enabled');

export default defineConfig({
  ...config,
  testDir: resolve(process.cwd(), '.checks/native-composite-diagnostic/source'),
  testMatch: 'native-composite-lifecycle.spec.ts',
  fullyParallel: false,
  workers: 1,
  retries: 0,
  outputDir: resolve(process.cwd(), '.checks/native-composite-diagnostic/result'),
  reporter: [
    ['list'],
    ['json', { outputFile: resolve(process.cwd(), '.checks/native-composite-diagnostic/results.json') }],
  ],
  use: { ...config.use, trace: 'on' },
  webServer: { ...server, cwd: resolve(process.cwd(), 'apps/fixtures') },
});
