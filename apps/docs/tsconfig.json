{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": false,
    "moduleResolution": "Bundler"
  },
  "include": ["src", "test", "test-dom", "*"],
  "exclude": ["src/service-worker"]
}
